# Basic identity / branding
SECRET_KEY=change-this-to-a-random-secret
PROJECT_NAME=MySeriesVideo
APP_VERSION=latest
SERVICE_NAME=menuwed

# Public URL for the site (optional)
PUBLIC_BASE_URL=

# Storage
DATA_DIR=/data
VENV_DIR=.venv

# Network / runtime
WEB_HOST=0.0.0.0
WEB_PORT=5000
PORT=5000
FLASK_ENV=production
IS_PRODUCTION=false

# Optional Gunicorn tuning
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Turnstile / bot protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false
TURNSTILE_ALLOWED_HOSTNAMES=

# Branding / release metadata is managed from menuwed_config.json
